    "/api/v1/shipments/{trackingNumber}/status": {
      "patch": {
        "tags": [
          "Shipments"
        ],
        "summary": "Change shipment status using an allowed transition",
        "description": "Moves a shipment to its next status (Created, PickedUp, InTransit, OutForDelivery, Delivered or Failed).",
        "operationId": "UpdateShipmentStatusV1",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
