{
  "openapi": "3.0.4",
  "info": {
    "title": "ApexPost Logistics API",
    "description": "Shipments, offline courier scan uploads and partner tracking. v2 groups recipient fields, adds latestScan and returns status as a string enum.",
    "contact": {
      "name": "ApexPost Platform Team",
      "email": "platform-team@apexpost.example"
    },
    "version": "v2"
  },
  "servers": [
    {
      "url": "https://localhost:7001/"
    }
  ],
