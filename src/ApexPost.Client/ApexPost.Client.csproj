<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ApexPost.Client</RootNamespace>
    <!--
      The typed client is generated by NSwag from contracts/v2.json on every build (see OpenApiReference
      below) and written to obj/, so it is never edited by hand. Generated code may raise style/nullable
      warnings that we do not control, so they are not treated as errors in this project only.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765;CS0108;CS0114;CS0472;CS0612;CS0649;CS1573;CS3016;CS8073</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Client">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="NSwag.ApiDescription.Client">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact generator configuration (the same settings are in nswag.json for the NSwag CLI). -->
    <OpenApiReference Include="../../contracts/v2.json"
                      CodeGenerator="NSwagCSharp"
                      Namespace="ApexPost.Client.Generated"
                      ClassName="ApexPostClient">
      <Options>/UseBaseUrl:false /GenerateClientInterfaces:true /InjectHttpClient:true /DisposeHttpClient:false /JsonLibrary:SystemTextJson /GenerateNullableReferenceTypes:true /OperationGenerationMode:SingleClientFromOperationId /ExceptionClass:ApexPostApiException /DateTimeType:System.DateTimeOffset /GenerateDtoTypes:true</Options>
    </OpenApiReference>
  </ItemGroup>
</Project>
