    "/api/v1/shipments/{trackingNumber}/scans": {
      "post": {
        "tags": [
          "Scans"
        ],
        "summary": "Upload offline scans idempotently",
        "description": "Uploads a batch of offline scans. Re-sending a scan ID is safe: it is counted as a duplicate.\nEvery scan's courierId must match the courierId claim in the caller's token.",
        "operationId": "UploadScansV1",
        "parameters": [
          {
            "name": "trackingNumber",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScanUploadRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
