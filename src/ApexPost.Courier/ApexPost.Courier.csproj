<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Courier client for Week 4 Part D. Following the trainer's guidance this is a .NET console client
    instead of a .NET MAUI app; it uses the same building blocks the MAUI app would use
    (IHttpClientFactory typed client, DelegatingHandler, Microsoft.Extensions.Http.Resilience,
    System.Text.Json source generation, protected token storage and connectivity-triggered sync).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>ApexPost.Courier</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.Extensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ApexPost.Courier.Offline/ApexPost.Courier.Offline.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ApexPost.Courier.Tests" />
  </ItemGroup>
</Project>
