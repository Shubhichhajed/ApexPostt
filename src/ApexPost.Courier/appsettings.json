{
  "ApexApi": {
    "Platform": "Windows",
    "BaseUrls": {
      "Windows": "https://localhost:7001/",
      "AndroidEmulator": "https://10.0.2.2:7001/"
    },
    "AllowUntrustedDevelopmentCertificate": false
  },
  "Resilience": {
    "MaxRetryAttempts": 3,
    "BaseDelaySeconds": 1,
    "AttemptTimeoutSeconds": 5,
    "TotalTimeoutSeconds": 45,
    "FailureRatio": 0.5,
    "MinimumThroughput": 4,
    "SamplingDurationSeconds": 30,
    "BreakDurationSeconds": 20
  },
  "Sync": {
    "BatchSize": 20,
    "HealthProbeSeconds": 5
  },
  "Courier": {
    "DataDirectory": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "Polly": "Warning"
    }
  }
}
