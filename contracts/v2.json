  "components": {
    "schemas": {
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string",
            "pattern": "^APX-\\d{8}$",
            "description": "Tracking number in APX-XXXXXXXX format."
          },
          "weight": {
            "type": "number",
            "format": "double",
            "minimum": 0.1,
            "maximum": 70,
            "description": "Shipment weight in kilograms, between 0.1 and 70."
          },
          "recipientName": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "description": "Recipient full name."
          },
          "recipientPhone": {
            "type": "string",
            "description": "Recipient contact phone number."
          },
          "recipientAddress": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "description": "Recipient delivery address."
          },
          "recipientCity": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "description": "Recipient city."
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Optional shipment notes."
          }
        }
      },
      "LatestScanInfo": {
        "type": "object",
        "properties": {
          "scanType": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaginatedShipmentsResponseOfShipmentResponseV2": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentResponseV2"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "pageSize": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "RecipientInfo": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        }
      },
      "ScanDetailResponse": {
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string"
          },
          "scanType": {
            "type": "string"
          },
          "courierId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ScanHistoryResponse": {
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "scans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanDetailResponse"
            }
          }
        }
      },
      "ScanItemRequest": {
        "required": [
          "scanId",
          "scanType",
          "courierId",
          "location"
        ],
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "pattern": "^scan::[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "description": "Stable client-generated identifier in scan::{Guid} format."
          },
          "scanType": {
            "type": "string",
            "pattern": "^(Pickup|InTransit|Delivered|Failed)$",
            "description": "Scan type: Pickup, InTransit, Delivered or Failed."
          },
          "courierId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "description": "Courier identifier from the authenticated courier identity."
          },
          "location": {
            "type": "string",
            "maxLength": 250,
            "minLength": 1,
            "description": "Human-readable location where the scan occurred."
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Optional notes; required for Delivered scans as recipient signature/name."
          }
        }
      },
      "ScanUploadRequest": {
        "required": [
          "scans"
        ],
        "type": "object",
        "properties": {
          "scans": {
            "maxItems": 100,
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanItemRequest"
            },
            "description": "One to one hundred offline scans."
          }
        }
      },
      "ScanUploadResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "integer",
            "format": "int32",
            "description": "Number of newly accepted scans."
          },
          "duplicatesSkipped": {
            "type": "integer",
            "format": "int32",
            "description": "Number of previously accepted scan IDs skipped as duplicates."
          },
          "rejected": {
            "type": "integer",
            "format": "int32",
            "description": "Number of rejected scans."
          },
          "rejectionReasons": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Reasons for rejected scans."
          }
        }
      },
      "ShipmentResponseV2": {
        "type": "object",
        "properties": {
          "trackingNumber": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/ShipmentStatus"
          },
          "weight": {
            "type": "number",
            "format": "double"
          },
          "recipient": {
            "$ref": "#/components/schemas/RecipientInfo"
          },
          "latestScan": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/LatestScanInfo"
              }
            ]
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ShipmentStatus": {
        "enum": [
          "Created",
          "PickedUp",
          "InTransit",
          "OutForDelivery",
          "Delivered",
          "Failed"
        ],
        "type": "string"
      },
      "UpdateShipmentRequest": {
        "required": [
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity"
        ],
        "type": "object",
        "properties": {
          "recipientName": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "description": "Recipient full name."
          },
          "recipientPhone": {
            "type": "string",
            "description": "Recipient contact phone number."
          },
          "recipientAddress": {
            "type": "string",
            "maxLength": 500,
            "minLength": 5,
            "description": "Recipient delivery address."
          },
          "recipientCity": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "description": "Recipient city."
          },
          "weight": {
            "type": "number",
            "format": "double",
            "minimum": 0.1,
            "maximum": 70,
            "description": "Shipment weight in kilograms, between 0.1 and 70."
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "maxLength": 1000,
            "description": "Optional shipment notes."
          }
        }
      },
      "UpdateStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(PickedUp|InTransit|OutForDelivery|Delivered|Failed)$",
            "description": "Next shipment status in the allowed transition sequence."
          }
        }
      },
      "ValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": {}
      }
    },
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "description": "Paste an access token (POST /dev/token in Development).",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "PartnerApiKey": {
        "type": "apiKey",
        "description": "Read-only partner API key.",
        "name": "X-Api-Key",
        "in": "header"
      }
    }
  },
  "tags": [
    {
      "name": "Shipments"
    },
    {
      "name": "Scans"
    },
    {
      "name": "Partner"
    }
  ]
}
